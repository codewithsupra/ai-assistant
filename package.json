{
  "name": "ai-assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "daytona:hello": "tsx --env-file=.env scripts/daytona-hello.ts",
    "set-webhook": "tsx --env-file=.env scripts/set-webhook.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test tests/gateway.test.ts tests/billing.test.ts tests/site.test.ts tests/agent-helpers.test.ts",
    "test:db": "tsx --env-file=.env --test tests/db.test.ts"
  },
  "dependencies": {
    "@daytona/sdk": "^0.231.1",
    "@hono/node-server": "^2.1.3",
    "@neon/ai-sdk-provider": "^1.3.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@trigger.dev/sdk": "^4.8.5",
    "ai": "^7.0.170",
    "drizzle-orm": "^0.45.4",
    "firecrawl": "^4.52.0",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@trigger.dev/build": "^4.8.5",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
