# Copy to .env and fill in. Never commit .env.

# Telegram (BotFather token; the secret is any long random string you choose)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=your_bot

# Neon Postgres: pooled for the app, direct for `drizzle-kit push`
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon AI Gateway (model access)
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
# AI_MODEL=claude-haiku-5-5

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_OAUTH_CLIENT_ID=

# Tools
FIRECRAWL_API_KEY=
DAYTONA_API_KEY=

# Optional
# FREE_MESSAGES_PER_MONTH=10
# AGENT_MAX_CONCURRENT_TURNS=4
# DATABASE_POOL_MAX=3
